# Dashboard listener. Keep loopback unless you intentionally need LAN access.
PIXEL_NAS_HOST=127.0.0.1
PIXEL_NAS_PORT=3000

# Android shared storage mount used for capacity monitoring.
PIXEL_NAS_STORAGE_PATH=/sdcard

# OPTIONAL: set this to the actual Resilio receive-only directory on the Pixel.
# Leave blank until you have confirmed the exact path on the device.
PIXEL_NAS_INBOX_DIR=

# Persistent ledger location. This is outside the Git checkout by default.
PIXEL_NAS_DATA_DIR=
PIXEL_NAS_DB_PATH=

# Ignore file path. The default is ../config/IgnoreList.txt from this folder.
PIXEL_NAS_IGNORE_LIST=

# Ingestion / telemetry intervals.
PIXEL_NAS_STABLE_WINDOW_MS=60000
PIXEL_NAS_INGESTION_POLL_MS=300000
PIXEL_NAS_MAX_HASH_BYTES_PER_SCAN=536870912
PIXEL_NAS_TELEMETRY_POLL_MS=10000

# Storage thresholds in GiB. The pause action is a webhook request, not proof
# that Resilio has stopped. Confirm the MacroDroid receiver before relying on it.
PIXEL_NAS_STORAGE_WARNING_GB=48
PIXEL_NAS_STORAGE_PAUSE_GB=55
PIXEL_NAS_STORAGE_RESUME_BELOW_GB=50
# Request a stop webhook if storage telemetry is unavailable (conservative default).
PIXEL_NAS_PAUSE_ON_STORAGE_UNKNOWN=true
PIXEL_NAS_STOP_WEBHOOK=http://127.0.0.1:5000/webhook/stop-resilio
PIXEL_NAS_STOP_WEBHOOK_METHOD=GET
PIXEL_NAS_WEBHOOK_TIMEOUT_MS=4000
PIXEL_NAS_WEBHOOK_RETRY_MS=30000

# Required when binding to a non-loopback address. Generate a random secret
# with: openssl rand -hex 32
PIXEL_NAS_AUTH_TOKEN=

# Only needed if the dashboard is accessed cross-origin. Comma-separated exact origins.
PIXEL_NAS_ALLOWED_ORIGINS=
